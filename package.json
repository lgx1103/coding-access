{
  "name": "ai-coding-access",
  "version": "0.1.22",
  "private": true,
  "description": "A private, model-aware coding gateway and desktop companion for teams.",
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "setup": "tsx scripts/setup.ts",
    "demo": "tsx scripts/demo.ts",
    "build": "npm run typecheck && vite build && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "desktop": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:mac": "npm run build && electron-builder --mac zip --arm64 --publish never",
    "package:win": "npm run build && electron-builder --win zip --x64 --publish never",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "test:agents": "tsx scripts/agent-smoke.ts",
    "test:load": "tsx scripts/load-smoke.ts",
    "package:server": "npm run build && node scripts/package-server.mjs",
    "test:terminal": "tsx scripts/terminal-smoke.ts",
    "dev:tauri": "tauri dev",
    "dev:tauri:web": "vite --mode tauri --host localhost --port 1420",
    "build:tauri:web": "vite build --mode tauri",
    "check:tauri": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test:tauri": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "package:tauri:mac": "tauri build --config src-tauri/tauri.release.conf.json --features distribution --bundles app",
    "package:tauri:win": "tauri build --config src-tauri/tauri.release.conf.json --features distribution --target x86_64-pc-windows-msvc --bundles nsis",
    "package:tauri:win:mac": "node scripts/package-tauri-win-macos.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@iarna/toml": "^2.2.5",
    "@radix-ui/react-select": "^2.3.7",
    "@tauri-apps/api": "^2.11.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.3",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semver": "^7.8.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "com.codingaccess.desktop",
    "productName": "Coding Access",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/desktop/**/*",
      "dist/web/**/*",
      "package.json",
      "!node_modules/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "icon": "assets/icon.icns",
      "bundleVersion": "0.1.20"
    },
    "win": {
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "artifactName": "Coding-Access-${version}-${os}-${arch}.${ext}"
  },
  "author": "Coding Access contributors",
  "license": "MIT"
}
